{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ESNext"],
    "types": ["bun", "node"]
  },
  "include": ["src/**/*.ts", "types/**/*.ts", "test/**/*.ts"]
}
